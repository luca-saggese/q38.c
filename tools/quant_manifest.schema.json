{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "q38 selective quantization manifest",
  "type": "object",
  "required": ["format", "model_revision", "rules"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "q38_quant_manifest_v2"},
    "model_revision": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "class", "pattern", "quant_type",
          "expected_min_matches", "expected_max_matches",
          "rationale", "include"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "quant_type": {"type": "string", "minLength": 1},
          "expected_min_matches": {"type": "integer", "minimum": 0},
          "expected_max_matches": {"type": "integer", "minimum": 0},
          "rationale": {"type": "string", "minLength": 1},
          "include": {"type": "boolean"},
          "layout_transform": {"type": "string"},
          "exclude": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
